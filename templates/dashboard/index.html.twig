{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - SIGEP Tchad
{% endblock %}

{% block body %}
	<!-- Header -->
	<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
		<div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
			<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
				<h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Tableau de bord</h1>
				<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
					<li class="breadcrumb-item text-muted">
						<a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
					</li>
					<li class="breadcrumb-item">
						<span class="bullet bg-gray-400 w-5px h-2px"></span>
					</li>
					<li class="breadcrumb-item text-muted">Vue d'ensemble</li>
				</ul>
			</div>
			<div class="d-flex align-items-center gap-2 gap-lg-3">
				<span class="text-gray-500 fs-7 fw-bold">{{ currentDate|date('F Y')|capitalize }}</span>
			</div>
		</div>
	</div>

	<!-- Content -->
	<div id="kt_app_content" class="app-content flex-column-fluid">
		<div
			id="kt_app_content_container" class="app-container container-xxl">

			<!-- Stats Widgets -->
			<div
				class="row g-5 g-xl-10 mb-5 mb-xl-10">
				<!-- Projets Actifs -->
				<div class="col-md-6 col-lg-3">
					<div class="card card-flush h-md-100" style="border-top: 4px solid #002664;">
						<div class="card-header pt-5">
							<div class="card-title d-flex flex-column">
								<div class="d-flex align-items-center">
									<span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">{{ stats.projectsActifs }}</span>
									{% if stats.projectsCeMois > 0 %}
										<span class="badge badge-light-success fs-base">
											<i class="ki-outline ki-arrow-up fs-5 text-success ms-n1"></i>
											+{{ stats.projectsCeMois }}
										</span>
									{% endif %}
								</div>
								<span class="text-gray-400 pt-1 fw-semibold fs-6">Projets actifs</span>
							</div>
						</div>
						<div class="card-body d-flex align-items-end pt-0 pb-5">
							<div class="d-flex align-items-center flex-column mt-3 w-100">
								<div class="d-flex justify-content-between w-100 mt-auto mb-2">
									<span class="fw-semibold fs-7 text-gray-400">Progression globale</span>
									<span class="fw-bold fs-7">{{ stats.tauxExecution }}%</span>
								</div>
								<div class="h-8px mx-3 w-100 bg-light-primary rounded">
									<div class="bg-primary rounded h-8px" role="progressbar" style="width: {{ stats.tauxExecution }}%;" aria-valuenow="{{ stats.tauxExecution }}" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Financements & Conventions -->
				<div class="col-md-6 col-lg-3">
					<div class="card card-flush h-md-100" style="border-top: 4px solid #fecb00;">
						<div class="card-header pt-5">
							<div class="card-title d-flex flex-column">
								<div class="d-flex align-items-center">
									<span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">{{ (stats.budgetTotal / 1000000000)|number_format(1, ',', ' ') }}</span>
									<span class="text-gray-400 fs-4 fw-bold mt-1">Mds</span>
								</div>
								<span class="text-gray-400 pt-1 fw-semibold fs-6">Budget total (FCFA)</span>
							</div>
						</div>
						<div class="card-body d-flex align-items-end pt-0 pb-5">
							<div class="d-flex align-items-center">
								<span class="badge badge-light-warning fs-7 fw-bold">{{ stats.totalFinancements }}
									financements /
									{{ stats.financementsActifs }}
									conventions</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Décaissements -->
				<div class="col-md-6 col-lg-3">
					<div class="card card-flush h-md-100" style="border-top: 4px solid #10b981;">
						<div class="card-header pt-5">
							<div class="card-title d-flex flex-column">
								<div class="d-flex align-items-center">
									<span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">{{ (stats.montantDecaissementsExecutes / 1000000000)|number_format(1, ',', ' ') }}</span>
									<span class="text-gray-400 fs-4 fw-bold mt-1">Mds</span>
								</div>
								<span class="text-gray-400 pt-1 fw-semibold fs-6">Décaissements exécutés</span>
							</div>
						</div>
						<div class="card-body d-flex align-items-end pt-0 pb-5">
							<div class="d-flex flex-column">
								<span class="fs-7 fw-bold text-gray-500">{{ stats.decaissementsEnAttente }}
									en attente de validation</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Audits & Risques -->
				<div class="col-md-6 col-lg-3">
					<div class="card card-flush h-md-100" style="border-top: 4px solid #c60c30;">
						<div class="card-header pt-5">
							<div class="card-title d-flex flex-column">
								<div class="d-flex align-items-center">
									<span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">{{ stats.totalAudits }}</span>
									<span class="badge badge-light-danger fs-base ms-2">{{ stats.auditsPlanifies }}
										planifiés</span>
								</div>
								<span class="text-gray-400 pt-1 fw-semibold fs-6">Audits de contrôle</span>
							</div>
						</div>
						<div class="card-body d-flex align-items-end pt-0 pb-5">
							<div class="d-flex align-items-center">
								<i data-lucide="alert-circle" class="text-danger me-2" style="width: 18px; height: 18px;"></i>
								<span class="fs-7 text-gray-500">{{ stats.projectsEnRetard }}
									projets en retard</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				class="row g-5 g-xl-10">
				<!-- Left Column: Chart and Recent Projects -->
				<div
					class="col-xl-8">
					<!-- Budget Chart -->
					<div class="card card-flush mb-5 mb-xl-10">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Exécution budgétaire par secteur</span>
								<span class="text-gray-400 mt-1 fw-semibold fs-7">Comparaison Budget vs Décaissement (Mds FCFA)</span>
							</h3>
							<div class="card-toolbar">
								<button class="btn btn-sm btn-light-primary" onclick="exportChart()">
									<i data-lucide="download" class="me-2" style="width: 14px; height: 14px;"></i>
									Exporter
								</button>
							</div>
						</div>
						<div class="card-body pt-2">
							<div class="chart-container" style="height: 350px;">
								<canvas id="budgetChart"></canvas>
							</div>
						</div>
					</div>

					<!-- Recent Projects -->
					<div class="card card-flush mb-5 mb-xl-10">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Projets récents</span>
								<span class="text-gray-400 mt-1 fw-semibold fs-7">Dernières mises à jour du portefeuille</span>
							</h3>
							<div class="card-toolbar">
								<a href="{{ path('app_projects') }}" class="btn btn-sm btn-light">Voir tout</a>
							</div>
						</div>
						<div class="card-body pt-2">
							<div class="table-responsive">
								<table class="table align-middle table-row-dashed fs-6 gy-3">
									<thead>
										<tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
											<th class="min-w-200px">Projet</th>
											<th class="min-w-100px">Secteur</th>
											<th class="min-w-100px">Budget</th>
											<th class="min-w-150px">Progression</th>
											<th class="min-w-100px text-end">Statut</th>
										</tr>
									</thead>
									<tbody class="fw-semibold text-gray-600">
										{% for project in recentProjects|slice(0, 5) %}
											<tr>
												<td>
													<div class="d-flex flex-column">
														<a href="{{ path('app_projects_show', {slug: project.slug}) }}" class="text-dark text-hover-primary fw-bold">{{ project.name }}</a>
														{% if project.priorite == 'haute' %}
															<span class="badge badge-light-danger fw-bold px-4 py-3 mt-1" style="width: fit-content;">Prioritaire</span>
														{% endif %}
													</div>
												</td>
												<td>
													<span class="badge badge-light-primary">{{ project.sectorLabel }}</span>
												</td>
												<td>
													{% if project.budgetTotal %}
														<span class="fw-bold">{{ (project.budgetTotal / 1000000000)|number_format(2, ',', ' ') }}
															Mds</span>
													{% else %}
														<span class="text-gray-400">Non défini</span>
													{% endif %}
												</td>
												<td>
													<div class="d-flex align-items-center w-100 flex-column mt-3">
														<div class="d-flex justify-content-between w-100 mt-auto mb-2">
															<span class="fw-bold fs-7">{{ project.progress }}%</span>
														</div>
														<div class="h-5px mx-3 w-100 bg-light rounded">
															{% set progColor = project.progress >= 75 ? 'success' : (project.progress >= 50 ? 'primary' : (project.progress >= 25 ? 'warning' : 'danger')) %}
															<div class="bg-{{ progColor }} rounded h-5px" role="progressbar" style="width: {{ project.progress }}%;"></div>
														</div>
													</div>
												</td>
												<td class="text-end">
													{% set statusBadge = {
                                                    'planifie': 'light-secondary',
                                                    'en-cours': 'light-primary',
                                                    'en-retard': 'light-danger',
                                                    'termine': 'light-success',
                                                    'suspendu': 'light-warning'
                                                } %}
													<span class="badge badge-{{ statusBadge[project.status] ?? 'light' }}">{{ project.statusLabel }}</span>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</div>
					</div>

					<!-- Recent Audits -->
					<div class="card card-flush">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Audits & Contrôles récents</span>
							</h3>
							<div class="card-toolbar">
								<a href="{{ path('app_audit_index') }}" class="btn btn-sm btn-light">Tous les audits</a>
							</div>
						</div>
						<div class="card-body pt-2">
							<div class="table-responsive">
								<table class="table align-middle table-row-dashed fs-6 gy-3">
									<thead>
										<tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
											<th>Titre / Mission</th>
											<th>Projet</th>
											<th>Date</th>
											<th class="text-end">Statut</th>
										</tr>
									</thead>
									<tbody class="fw-semibold text-gray-600">
										{% for audit in recentAudits %}
											<tr>
												<td>{{ audit.title }}</td>
												<td>{{ audit.project ? audit.project.name|u.truncate(30) : 'Général' }}</td>
												<td>{{ audit.dateAudit|date('d/m/Y') }}</td>
												<td class="text-end">
													{% set auditColor = {
                                                    'planifie': 'warning',
                                                    'en_cours': 'primary',
                                                    'termine': 'success'
                                                }[audit.statut] ?? 'secondary' %}
													<span class="badge badge-light-{{ auditColor }}">{{ audit.statut|capitalize }}</span>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<!-- Right Column: Activity, Partners and more -->
				<div
					class="col-xl-4">
					<!-- Activity Feed -->
					<div class="card card-flush mb-5 mb-xl-10">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Activité récente</span>
								<span class="text-gray-400 mt-1 fw-semibold fs-7">Derniers événements système</span>
							</h3>
						</div>
						<div class="card-body pt-5">
							<div class="timeline-label">
								{% for activite in activitesRecentes %}
									<div class="timeline-item">
										<div class="timeline-label fw-bold text-gray-800 fs-6">
											{% if activite.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
												Auj.
											{% else %}
												{{ activite.date|date('d/m') }}
											{% endif %}
										</div>
										<div class="timeline-badge">
											{% set dotColor = {
                                            'green': 'success',
                                            'blue': 'primary',
                                            'gold': 'warning',
                                            'red': 'danger'
                                        }[activite.iconClass] ?? 'secondary' %}
											<i class="fa fa-genderless text-{{ dotColor }} fs-1"></i>
										</div>
										<div class="timeline-content fw-semibold text-gray-600 ps-3">
											<div class="fw-bold text-dark fs-6">{{ activite.title }}</div>
											<div class="fs-7">{{ activite.description }}</div>
										</div>
									</div>
								{% endfor %}
							</div>
						</div>
					</div>

					<!-- Top Partners -->
					<div class="card card-flush mb-5 mb-xl-10">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Partenaires principaux</span>
							</h3>
						</div>
						<div class="card-body pt-5">
							{% for partner in topPartners %}
								<div class="d-flex flex-stack mb-7">
									<div class="symbol symbol-40px symbol-circle me-3">
										<span class="symbol-label bg-light-info text-info fw-bold">{{ partner.acronym|slice(0, 2) }}</span>
									</div>
									<div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
										<div class="me-auto">
											<a href="#" class="text-gray-800 text-hover-primary fw-bold font-size-h6">{{ partner.name }}</a>
											<span class="text-gray-400 fw-semibold d-block fs-7">{{ partner.acronym }}</span>
										</div>
										<div class="d-flex align-items-center">
											<span class="text-gray-800 fw-bold fs-6 me-3">{{ partner.projectCount }}
												projets</span>
										</div>
									</div>
								</div>
							{% endfor %}
							<div class="text-center mt-5">
								<a href="{{ path('app_partners') }}" class="btn btn-sm btn-light">Gérer les partenaires</a>
							</div>
						</div>
					</div>

					<!-- Sector Breakdown -->
					<div class="card card-flush">
						<div class="card-header pt-7">
							<h3 class="card-title align-items-start flex-column">
								<span class="card-label fw-bold text-dark">Répartition par secteur</span>
							</h3>
						</div>
						<div class="card-body pt-5">
							{% set totalBudget = 0 %}
							{% for sector, data in sectorsData %}
								{% set totalBudget = totalBudget + data.budget %}
							{% endfor %}

							{% set sectorColors = {
                            'infrastructure': 'primary',
                            'sante': 'success',
                            'energie': 'warning',
                            'agriculture': 'info',
                            'education': 'danger',
                            'eau': 'dark'
                        } %}
							{% set sectorLabels = {
                            'infrastructure': 'Infrastructure',
                            'sante': 'Santé',
                            'energie': 'Énergie',
                            'agriculture': 'Agriculture',
                            'education': 'Éducation',
                            'eau': 'Eau & Assainissement'
                        } %}

							{% for sector, data in sectorsData %}
								{% set percentage = totalBudget > 0 ? ((data.budget / totalBudget) * 100)|round(0) : 0 %}
								<div class="d-flex flex-stack mb-5">
									<div class="d-flex align-items-center me-2">
										<div class="symbol symbol-35px symbol-circle me-3">
											<span class="symbol-label bg-light-{{ sectorColors[sector] ?? 'secondary' }}">
												<i class="ki-outline ki-abstract-26 fs-4 text-{{ sectorColors[sector] ?? 'secondary' }}"></i>
											</span>
										</div>
										<div class="d-flex flex-column">
											<a href="#" class="text-dark text-hover-primary fw-bold">{{ sectorLabels[sector] ?? sector|capitalize }}</a>
											<span class="text-muted fw-semibold fs-7">{{ (data.budget / 1000000000)|number_format(1, ',', ' ') }}
												Mds FCFA</span>
										</div>
									</div>
									<div class="d-flex align-items-center">
										<span class="text-dark fw-bold fs-6 me-3">{{ percentage }}%</span>
										<div class="progress h-6px w-50px bg-light-{{ sectorColors[sector] ?? 'secondary' }}">
											<div class="progress-bar bg-{{ sectorColors[sector] ?? 'secondary' }}" role="progressbar" style="width: {{ percentage }}%"></div>
										</div>
									</div>
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () { // Initialisation des icônes Lucide si disponibles
if (typeof lucide !== 'undefined') {
lucide.createIcons();
}

// Données pour le graphique par secteur
const sectorsData = {{ sectorsData|json_encode|raw }};

const sectorLabels = {
'infrastructure': 'Infrastructure',
'sante': 'Santé',
'energie': 'Énergie',
'agriculture': 'Agriculture',
'education': 'Éducation',
'eau': 'Eau & Assainissement'
};

const labels = [];
const budgets = [];
const decaisses = [];

for (const [key, data] of Object.entries(sectorsData)) {
labels.push(sectorLabels[key] || key);
budgets.push((data.budget / 1000000000).toFixed(2));
decaisses.push((data.decaisse / 1000000000).toFixed(2));
}

// Graphique Budget par secteur
const budgetCtx = document.getElementById('budgetChart');
if (budgetCtx && labels.length > 0) {
new Chart(budgetCtx, {
type: 'bar',
data: {
labels: labels,
datasets: [
{
label: 'Budget engagé (Mds FCFA)',
data: budgets,
backgroundColor: 'rgba(0, 38, 100, 0.85)',
borderColor: '#002664',
borderWidth: 1,
borderRadius: 6
}, {
label: 'Montant décaissé (Mds FCFA)',
data: decaisses,
backgroundColor: 'rgba(254, 203, 0, 0.85)',
borderColor: '#FECB00',
borderWidth: 1,
borderRadius: 6
}
]
},
options: {
responsive: true,
maintainAspectRatio: false,
plugins: {
legend: {
position: 'bottom',
labels: {
usePointStyle: true,
padding: 20,
font: {
size: 12
}
}
},
tooltip: {
backgroundColor: 'rgba(0, 0, 0, 0.8)',
padding: 12,
titleFont: {
size: 14,
weight: 'bold'
},
bodyFont: {
size: 13
},
callbacks: {
label: function (context) {
return context.dataset.label + ': ' + context.raw + ' Mds FCFA';
}
}
}
},
scales: {
x: {
grid: {
display: false
},
ticks: {
font: {
size: 11
}
}
},
y: {
beginAtZero: true,
grid: {
color: 'rgba(0, 0, 0, 0.05)'
},
ticks: {
font: {
size: 11
},
callback: function (value) {
return value + ' Mds';
}
}
}
}
}
});
}
});

// Fonction d'export
function exportChart() {
const canvas = document.getElementById('budgetChart');
if (canvas) {
const link = document.createElement('a');
link.download = 'execution-budgetaire-secteur.png';
link.href = canvas.toDataURL();
link.click();
}
}
	</script>
{% endblock %}
